{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "Puzzle",
  "description": "Unlocks advanced capabilities for resourcepack authors, such as customizing the splashscreen and allowing for bigger block models.",
  "authors": [
    "PuzzleMC",
    "Motschen"
  ],
  "contact": {
    "homepage": "https://www.midnightdust.eu/",
    "sources": "https://github.com/TeamMidnightDust/Puzzle",
    "issues": "https://github.com/TeamMidnightDust/Puzzle/issues"
  },

  "license": "MIT",
  "icon": "assets/puzzle/icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "net.puzzlemc.core.PuzzleClient"
    ]
  },

  "mixins": [
    "puzzle-models.mixins.json",
    "puzzle-splashscreen.mixins.json",
    "puzzle-predicates.mixins.json"
  ],

  "depends": {
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  },
  "breaks": {
    "entity_texture_features": "<7.0.0",
    "entity_model_features": "<3.0.0"
  }
}
